<% layout("layouts/boilerplate") %> 

<style>
    .filters{
    display: flex;
}

.filter{
    margin-right: 3.2rem;
    font-size: 0.95rem;
    opacity: 0.7;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.filter p{
    margin-bottom: 0;
}

.filter:hover{
    opacity: 1;
    cursor: pointer;
}

.tax-info{
    display: none;
}

.tax-toggle{
    border: 1px solid #ddd;
    border-radius: 30px;
    padding: 6px 14px;
    font-size: 0.9rem;
    background-color: white;
}  
    
</style>

<div class="container mt-3 mb-3">
  <div class="d-flex align-items-center">

    <!-- LEFT SIDE: Filters -->
    <div class="filters">
        <div class="filter">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-campground"></i>
            <p>Camping</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Pool</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-cow"></i>
            <p>Farm</p>
        </div>
        <div class="filter">
            <i class="fa-brands fa-fort-awesome"></i>
            <p>Villa</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-person-skiing"></i>
            <p>Arctic</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-igloo"></i>
            <p>Domes</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-mountain-sun"></i>
            <p>Mountain</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-mountain-city"></i>
            <p>Iconic Citys</p>
        </div>
    </div>

    
    <!-- RIGHT SIDE: Tax Toggle -->
    <div class="tax-toggle ms-auto">
        <div class="form-check form-switch d-flex align-items-center gap-2">
            <input class="form-check-input  " type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label mb-0" for="flexSwitchCheckDefault">
                Show Including Taxes
            </label>
        </div>
    </div>

  </div>
</div>
    <%success%>

    <!-- <a href="/listings/new">Create New Listing</a> -->
    <div class="row row-cols-lg-3 row row-cols-md-2 row row-cols-sm-1">
        <% for (let listing of allListings) { %>

            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card ">
                    <img src="<%=  listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= listing.title %>
                            </b>
                            <br>
                            &#8377; <%= listing.price.toLocaleString() %>  /night
                            <i class="tax-info">&nbsp;&nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>


            <% } %>
    </div>

    <script>
        
        let taxSwitch = document.getElementById('flexSwitchCheckDefault');

if(taxSwitch){
    taxSwitch.addEventListener("click", ()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
        for (const info of taxInfo) {
            info.style.display = info.style.display !== "inline" ? "inline" : "none";
        }
    });
}
        
    </script>